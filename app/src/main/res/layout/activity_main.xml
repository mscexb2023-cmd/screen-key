<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_mode"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="4dp" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/modeKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_key"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/modeInverted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_inverted"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/modeFrontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_frontal"
                android:textSize="15sp" />

        </RadioGroup>

        <Switch
            android:id="@+id/frontalBudsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_frontal_buds"
            android:textSize="15sp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <Switch
            android:id="@+id/bootSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_boot"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/grantOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_grant_overlay"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_start"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/stopBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_stop"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/settingsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_settings"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_test"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_text"
            android:textSize="14sp"
            android:textColor="#666666" />

    </LinearLayout>
</ScrollView>
